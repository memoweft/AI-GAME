# Local GUI model runtime configuration template. Copy this file to
# model-runtime.env and set values for this machine; the real file is ignored.
# This file is shell-compatible because the WSL lifecycle scripts source it.
# GUI_MODEL_API_KEY is a local loopback bearer token used by both the GUI-Owl
# server and the console backend. Never put cloud-provider credentials here.
AI_GAME_RUNTIME_ROOT=/srv/ai-game
GUI_MODEL_ROOT=/mnt/f/AI-GAME/runtime/models
GUI_MODEL_API_KEY=replace-with-a-local-token
GUI_MODEL_HOST=127.0.0.1
GUI_MODEL_PORT=4243

# Pin the GUI model artifact used by scripts/model-runtime.ps1 bootstrap.
GUI_MODEL_ID=mPLUG/GUI-Owl-1.5-8B-Instruct
GUI_MODEL_REVISION=06d5faecff74840bab2be2425e9c42667a5d04fc
GUI_MODEL_SERVED_NAME=gui-owl-1.5-8b-instruct
GUI_MODEL_GPU_MEMORY_UTILIZATION=0.78
GUI_MODEL_MIN_FREE_MIB=20500
GUI_MODEL_MAX_MODEL_LEN=2048

GUI_MODEL_MAX_NUM_SEQS=1
GUI_MODEL_MAX_IMAGES=1
GUI_MODEL_LONGEST_EDGE=1003520
GUI_MODEL_SHORTEST_EDGE=65536
