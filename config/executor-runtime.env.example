# Non-secret default Android executor configuration. MuMu users can run the
# sync script while VM 0 is started. For a USB/Wi-Fi phone or tablet, set an
# absolute platform-tools adb.exe path and the exact serial from `adb devices`.
AI_GAME_GUI_EXECUTOR_ENABLED=1
AI_GAME_ADB_PATH=D:\Software\MuMuPlayer\nx_device\15.0\shell\adb.exe
AI_GAME_ADB_SERIAL=127.0.0.1:16384
