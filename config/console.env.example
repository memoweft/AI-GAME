# Loopback-only local console configuration.
AI_GAME_CONSOLE_HOST=127.0.0.1
AI_GAME_CONSOLE_PORT=4310

# Generated data belongs under runtime and is not source-controlled.
AI_GAME_DATA_DIR=F:\AI-GAME\runtime\console

# Optional overrides. Leave unset when adb is already on PATH. The launcher also
# adopts one unambiguous, already-running adb.exe without starting it.
# AI_GAME_ADB_PATH=C:\path\to\adb.exe
# AI_GAME_PROJECT_ROOT=F:\AI-GAME
